POSTGRES_DB=adii_kg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Use @db:5432 if running in Docker, or @localhost:5432 if running locally
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/adii_kg

RAW_TEXT_DIR=data/raw_text
METADATA_DIR=data/metadata
OUT_JSONL=data/processed/documents.jsonl
GRAPH_OUT=data/processed/graph_data.json

# Optional: directory containing original PDFs to be extracted
# PDF_DIR=data/pdf
